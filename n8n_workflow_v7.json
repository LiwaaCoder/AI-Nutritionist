                        }
                    ]
                }
            },
            "id": "bee95cb9-8c6c-485b-97e1-fa994b1513ae",
            "name": "Is there an Image?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                -128,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "// Prepare Image Data Manually\n// This bypasses n8n's expression limitations\n\nconst item = items[0];\nlet imageInfo = \"Assuming NO Image\";\nlet finalImage = \"\";\n\nif (item.binary && item.binary.data) {\n  const bData = item.binary.data;\n  // Check if data key exists (base64 string)\n  if (bData.data) {\n     imageInfo = \"Image Found & Processed\";\n     finalImage = `data:${bData.mimeType};base64,${bData.data}`;\n  } else {\n     imageInfo = \"Binary Metadata Found but Data Empty\";\n     finalImage = \"\";\n  }\n} else {\n  imageInfo = \"No Binary Object\";\n}\n\nitem.json.imageInfo = imageInfo;\nitem.json.finalImage = finalImage;\n\nreturn items;"
            },
            "id": "custom-code-node-1",
            "name": "Process Image Code",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                128,
                -128
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://nutrition-bot:3000/api/chat",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "userId",
                            "value": "={{ $json.message.from.id.toString() }}"
                        },
                        {
                            "name": "message",
                            "value": "={{ ($json.message.caption || $json.message.text || \"\") + \" [V7 DEBUG: \" + $json.imageInfo + \" | Len=\" + $json.finalImage.length + \"]\" }}"
                        },
                        {
                            "name": "image",
                            "value": "={{ $json.finalImage }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "6c293d50-a924-41d3-9fce-51f9c3fb4f6b",
